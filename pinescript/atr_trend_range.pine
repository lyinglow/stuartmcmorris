//@version=5
indicator("ATR Trend & Range Model", shorttitle="ATR-TRM", overlay=true, max_labels_count=200)

// ---------------------------------------------------------------------------
// Inputs
// ---------------------------------------------------------------------------
grpCore = "Core"
atrLen     = input.int(14, "ATR Length", minval=1, group=grpCore)
macroMult  = input.float(3.0, "Macro Trend Multiplier", minval=0.1, step=0.1, group=grpCore, tooltip="Wider band = slower, more reliable trend line. Drives buy/sell signals and the stop loss.")
microMult  = input.float(1.5, "Fast Band Multiplier", minval=0.1, step=0.1, group=grpCore, tooltip="Tighter band = reacts faster. Paired with the macro band to draw the trend cloud.")
srcInput   = input.source(hl2, "Source", group=grpCore)

grpDisplay = "Display"
showCloud   = input.bool(true, "Show Trend Cloud", group=grpDisplay)
showSignals = input.bool(true, "Show Buy/Sell Signals", group=grpDisplay)
showStop    = input.bool(true, "Show Stop Loss Line", group=grpDisplay)
showTable   = input.bool(true, "Show Info Table", group=grpDisplay)

// ---------------------------------------------------------------------------
// ATR trailing band (SuperTrend-style), reused for macro and fast bands
// ---------------------------------------------------------------------------
atr = ta.atr(atrLen)

f_band(mult) =>
    upperBasic = srcInput + mult * atr
    lowerBasic = srcInput - mult * atr
    var float upperBand = na
    var float lowerBand = na
    upperBand := upperBasic < nz(upperBand[1], upperBasic) or close[1] > nz(upperBand[1], upperBasic) ? upperBasic : nz(upperBand[1])
    lowerBand := lowerBasic > nz(lowerBand[1], lowerBasic) or close[1] < nz(lowerBand[1], lowerBasic) ? lowerBasic : nz(lowerBand[1])
    var int trend = 1
    trend := trend == -1 and close > upperBand[1] ? 1 : trend == 1 and close < lowerBand[1] ? -1 : trend
    line = trend == 1 ? lowerBand : upperBand
    [line, trend, upperBand, lowerBand]

[macroLine, macroTrend, macroUpper, macroLower] = f_band(macroMult)
[fastLine, fastTrend, fastUpper, fastLower]      = f_band(microMult)

// ---------------------------------------------------------------------------
// Signals
// ---------------------------------------------------------------------------
buySignal  = macroTrend == 1 and macroTrend[1] == -1
sellSignal = macroTrend == -1 and macroTrend[1] == 1

// ---------------------------------------------------------------------------
// Volatility ("liveliness")
// ---------------------------------------------------------------------------
atrPct    = atr / close * 100
atrPctAvg = ta.sma(atrPct, 50)
livelinessLabel = atrPct > atrPctAvg * 1.2 ? "High" : atrPct < atrPctAvg * 0.8 ? "Low" : "Normal"

// ---------------------------------------------------------------------------
// Plots
// ---------------------------------------------------------------------------
macroColor = macroTrend == 1 ? color.new(color.green, 0) : color.new(color.red, 0)
fastColor  = fastTrend == 1 ? color.new(color.lime, 40) : color.new(color.orange, 40)

pMacro = plot(showStop ? macroLine : na, title="Macro Trend / Stop Loss", color=macroColor, linewidth=2, style=plot.style_linebr)
pFast  = plot(showCloud ? fastLine : na, title="Fast Band", color=fastColor, linewidth=1, style=plot.style_linebr)

fill(pMacro, pFast, color=macroTrend == 1 ? color.new(color.green, 85) : color.new(color.red, 85), title="Trend Cloud", display=showCloud ? display.all : display.none)

bgcolor(livelinessLabel == "High" ? color.new(color.yellow, 92) : na, title="High Volatility Highlight")

plotshape(showSignals and buySignal ? macroLine : na, title="Buy", style=shape.labelup, location=location.absolute, color=color.green, text="BUY", textcolor=color.white, size=size.small)
plotshape(showSignals and sellSignal ? macroLine : na, title="Sell", style=shape.labeldown, location=location.absolute, color=color.red, text="SELL", textcolor=color.white, size=size.small)

// ---------------------------------------------------------------------------
// Info table
// ---------------------------------------------------------------------------
if showTable and barstate.islast
    var table t = table.new(position.top_right, 2, 4, border_width=1)
    table.cell(t, 0, 0, "Macro Trend", bgcolor=color.gray, text_color=color.white)
    table.cell(t, 1, 0, macroTrend == 1 ? "Bullish" : "Bearish", bgcolor=macroTrend == 1 ? color.green : color.red, text_color=color.white)
    table.cell(t, 0, 1, "Liveliness", bgcolor=color.gray, text_color=color.white)
    table.cell(t, 1, 1, livelinessLabel + " (" + str.tostring(atrPct, "#.##") + "%)", bgcolor=color.new(color.blue, 60), text_color=color.white)
    table.cell(t, 0, 2, "Stop Loss", bgcolor=color.gray, text_color=color.white)
    table.cell(t, 1, 2, str.tostring(macroLine, format.mintick), bgcolor=color.new(color.gray, 60), text_color=color.white)
    table.cell(t, 0, 3, "Fast Band", bgcolor=color.gray, text_color=color.white)
    table.cell(t, 1, 3, str.tostring(fastLine, format.mintick), bgcolor=color.new(color.gray, 60), text_color=color.white)

// ---------------------------------------------------------------------------
// Alerts
// ---------------------------------------------------------------------------
alertcondition(buySignal, title="ATR-TRM Buy", message="ATR-TRM: macro trend turned bullish, potential buy.")
alertcondition(sellSignal, title="ATR-TRM Sell", message="ATR-TRM: macro trend turned bearish, potential sell.")
alertcondition(livelinessLabel == "High" and livelinessLabel[1] != "High", title="ATR-TRM Volatility Spike", message="ATR-TRM: volatility jumped to High.")
